---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import ProjectCard from '../components/cards/ProjectCard.astro';
import Footer from '../components/layout/Footer.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { projects } from '../content/projects';

const categories = ['All', 'Personal', 'Hackathon', 'Academic', 'Research'];
---

<BaseLayout title="All Projects — Jen Patrick Nataba">
  <Navbar />
  <main class="pt-32 pb-24 bg-section-alt min-h-screen">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <!-- Back Link -->
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors duration-300 mb-12"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>

      <SectionHeading
        label="All Projects"
        eyebrow="Portfolio"
        description="Every project I've built — from data pipelines to machine learning models."
      />

      <!-- Filter Bar -->
      <div class="flex flex-wrap gap-3 mb-12 justify-center" id="project-filters">
        {categories.map((cat, i) => (
          <button 
            class={`filter-btn badge px-4 py-2 text-sm cursor-pointer transition-all border ${i === 0 ? 'bg-accent-500/20 border-accent-500/50 text-accent-300' : 'bg-dark-800 border-dark-600 text-muted hover:bg-dark-700'}`}
            data-filter={cat === 'All' ? 'all' : cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
        {projects.map((project, index) => (
           <div class="project-wrapper transition-all duration-200 animate-in fade-in zoom-in duration-200" data-category={project.category}>
             <ProjectCard project={project} index={index} disableAnimation={true} />
           </div>
        ))}
      </div>
      
      <!-- Empty state -->
      <div id="no-projects" class="hidden text-center py-20">
        <p class="text-secondary">No projects found for this category yet.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  function setupFiltering() {
    const buttons = document.querySelectorAll('.filter-btn');
    const projects = document.querySelectorAll('.project-wrapper');
    const noProjectsMsg = document.getElementById('no-projects');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        // Update active state of buttons
        buttons.forEach(btn => {
          btn.classList.remove('bg-accent-500/20', 'border-accent-500/50', 'text-accent-300');
          btn.classList.add('bg-dark-800', 'border-dark-600', 'text-muted');
        });
        button.classList.add('bg-accent-500/20', 'border-accent-500/50', 'text-accent-300');
        button.classList.remove('bg-dark-800', 'border-dark-600', 'text-muted');

        // Filter projects
        const filter = (button as HTMLElement).dataset.filter;
        let visibleCount = 0;

        projects.forEach(proj => {
          const el = proj as HTMLElement;
          const category = el.dataset.category;
          
          if (filter === 'all' || filter === category) {
            el.style.display = 'block';
            // Slight delay for animation
            setTimeout(() => {
              el.style.opacity = '1';
              el.style.transform = 'scale(1)';
            }, 50);
            visibleCount++;
          } else {
            el.style.opacity = '0';
            el.style.transform = 'scale(0.95)';
            setTimeout(() => {
              el.style.display = 'none';
            }, 300);
          }
        });

        // Show empty message if needed
        if (noProjectsMsg) {
          setTimeout(() => {
            if (visibleCount === 0) {
              noProjectsMsg.classList.remove('hidden');
            } else {
              noProjectsMsg.classList.add('hidden');
            }
          }, 300);
        }
      });
    });
  }

  setupFiltering();
  document.addEventListener('astro:page-load', setupFiltering);
</script>
