---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import TalkCard from '../components/cards/TalkCard.astro';
import Footer from '../components/layout/Footer.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { talks } from '../content/talks';
---

<BaseLayout title="All Talks — Jen Patrick Nataba">
  <Navbar />
  <main class="pt-32 pb-24 bg-section-alt min-h-screen">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
      <!-- Back Link -->
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors duration-300 mb-12"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>

      <SectionHeading
        label="All Talks & Events"
        eyebrow="Speaking"
        description="A complete timeline of workshops and speaking engagements sharing knowledge with the community."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="talks-grid">
        {talks.map((talk, index) => (
           <div class="talk-wrapper transition-all duration-200 animate-in fade-in zoom-in duration-200">
             <TalkCard talk={talk} index={index} />
           </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
