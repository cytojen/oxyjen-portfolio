---
import type { Experience } from '../../content/experience';

interface Props {
  experience: Experience;
  index: number;
  isLeft: boolean;
}

const { experience, index, isLeft } = Astro.props;
const revealClass = isLeft ? 'reveal-left' : 'reveal-right';
---

<div class={`relative flex items-start ${isLeft ? 'lg:justify-start' : 'lg:justify-end'}`}>
  
  <!-- Desktop Company Logo centered on the opposite half -->
  <div 
    class={`hidden lg:flex absolute top-1/2 -translate-y-1/2 ${isLeft ? 'left-[75%] -translate-x-1/2' : 'left-[25%] -translate-x-1/2'} z-20 reveal-scale`} 
    style={`transition-delay: ${index * 100 + 150}ms;`}
  >
    <img
      src={experience.logo}
      alt={experience.company}
      class="w-64 h-64 xl:w-72 xl:h-72 object-contain drop-shadow-2xl"
      loading="lazy"
    />
  </div>

  <div
    class={`glass-card rounded-2xl p-6 md:p-8 w-full lg:w-[calc(50%-3rem)] group hover:-translate-y-1 hover:shadow-lg hover:shadow-accent-500/5 ${revealClass} relative overflow-hidden`}
    style={`transition-delay: ${index * 100}ms;`}
  >
    <!-- Header -->
    <div class="flex flex-col gap-5 mb-5 text-left">
      <!-- Mobile Company Logo (hidden on desktop) -->
      <div class="lg:hidden w-16 h-16 sm:w-20 sm:h-20 rounded-2xl glass-card flex items-center justify-center shrink-0 overflow-hidden mb-2">
        <img
          src={experience.logo}
          alt={experience.company}
          class="w-10 h-10 sm:w-12 sm:h-12 object-contain"
          loading="lazy"
        />
      </div>

      <div class="flex-1 min-w-0 flex flex-col items-start text-left">
        <h3 class="text-xl font-semibold text-primary leading-tight text-left" style="font-family: 'Outfit', sans-serif;">
          {experience.role}
        </h3>
        <p class="text-accent text-sm font-medium mt-1 text-left">{experience.company}</p>
        
        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted mt-3 justify-start">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {experience.location}
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {experience.period}
          </span>
          <span class="badge text-[10px] py-0.5 px-2">{experience.type}</span>
        </div>
      </div>
    </div>

    <!-- Description -->
    <p class="text-secondary text-sm leading-relaxed mb-5 text-left">
      {experience.description}
    </p>

    <!-- Achievements -->
    <div class="space-y-2.5 mb-5 relative z-10">
      {experience.achievements.map((achievement) => (
        <div class="flex gap-2.5 text-sm text-secondary leading-relaxed text-left">
          <svg class="w-4 h-4 text-accent-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
          </svg>
          <span>{achievement}</span>
        </div>
      ))}
    </div>

    <!-- Technologies -->
    <div class="flex flex-wrap gap-1.5 relative z-10 justify-start">
      {experience.technologies.map((tech) => (
        <span class="badge text-[10px]">{tech}</span>
      ))}
    </div>
  </div>
</div>
