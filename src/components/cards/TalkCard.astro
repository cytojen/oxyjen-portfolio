---
import type { Talk } from '../../content/talks';

interface Props {
  talk: Talk;
  index: number;
  disableAnimation?: boolean;
}

const { talk, index, disableAnimation = false } = Astro.props;
const modalId = `talk-modal-${talk.id}`;
---

<!-- Card -->
<div
  class={`glass-card rounded-2xl overflow-hidden group hover:-translate-y-1 hover:shadow-xl hover:shadow-accent-500/5 transition-all duration-500 ${disableAnimation ? '' : 'reveal'} cursor-pointer flex flex-col h-full`}
  style={disableAnimation ? '' : `transition-delay: ${index * 150}ms;`}
  data-open-modal={modalId}
>
  <!-- Thumbnail -->
  <div class="relative h-52 md:h-60 overflow-hidden bg-section-alt shrink-0">
    <img
      src={talk.image}
      alt={talk.title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-section-alt via-transparent to-transparent pointer-events-none opacity-60"></div>

    <!-- Floating badges on image -->
    <div class="absolute bottom-4 left-4 right-4 flex flex-wrap gap-1.5 pointer-events-none">
        <span class="badge text-[10px] bg-section/80 backdrop-blur-sm border-subtle">{talk.host}</span>
        <span class="badge text-[10px] bg-section/80 backdrop-blur-sm border-subtle">{talk.venue}</span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-grow">
    <h3
      class="text-lg font-semibold text-primary mb-2 group-hover:text-accent transition-colors duration-300"
      style="font-family: 'Outfit', sans-serif;"
    >
      {talk.title}
    </h3>
    {talk.role && (
      <p class="text-accent-400 text-xs mb-3 font-medium">{talk.role}</p>
    )}

    <p class="text-secondary text-sm leading-relaxed line-clamp-3 mb-4">
      {talk.description}
    </p>

    <!-- Visual cue to click -->
    <div class="mt-auto pt-4 border-t border-subtle text-xs font-medium text-accent flex items-center gap-2 group-hover:gap-3 transition-all">
      Read More
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </div>
  </div>
</div>

<!-- Modal -->
<dialog 
  id={modalId} 
  class="backdrop:bg-section-alt/80 backdrop:backdrop-blur-sm bg-transparent w-[90vw] max-w-3xl m-auto rounded-3xl p-0 border border-subtle shadow-2xl focus:outline-none"
>
  <div class="bg-section overflow-hidden rounded-3xl max-h-[85vh] flex flex-col">
    <!-- Modal Header/Image -->
    <div class="relative h-64 sm:h-80 shrink-0 bg-section-alt">
      <img
        src={talk.image}
        alt={talk.title}
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <!-- Adjust gradient for theme compatibility -->
      <div class="absolute inset-0 bg-gradient-to-t from-section via-transparent to-section-alt/40"></div>
      
      <!-- Close Button -->
      <button 
        data-close-modal={modalId}
        class="absolute top-4 right-4 w-10 h-10 rounded-full bg-section-alt/50 backdrop-blur-md border border-subtle flex items-center justify-center text-primary hover:bg-section-alt transition-colors"
        aria-label="Close modal"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="absolute bottom-6 left-6 right-6 z-10">
        <h3 class="text-2xl sm:text-3xl font-bold drop-shadow-md" style="font-family: 'Outfit', sans-serif; color: var(--color-accent-400);">
          {talk.title}
        </h3>
        {talk.role && (
          <p class="text-accent-300 text-sm mt-1 font-medium drop-shadow-md">{talk.role}</p>
        )}
      </div>
    </div>

    <!-- Modal Content (Scrollable) -->
    <div class="p-6 sm:p-8 overflow-y-auto custom-scrollbar flex-1 bg-section" data-lenis-prevent>
      <div class="mb-8">
        <h4 class="text-sm font-semibold text-primary uppercase tracking-widest mb-3">Overview</h4>
        <div class="flex justify-between items-start mb-4">
        </div>
        <p class="text-secondary leading-relaxed">
          {talk.description}
        </p>
      </div>

      <div class="mb-8">
        <h4 class="text-sm font-semibold text-primary uppercase tracking-widest mb-3">Details</h4>
        <div class="flex flex-wrap gap-2">
          <span class="badge py-1 px-3 border border-subtle text-secondary bg-transparent">Host: {talk.host}</span>
          <span class="badge py-1 px-3 border border-subtle text-secondary bg-transparent">Venue: {talk.venue}</span>
        </div>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap gap-4 pt-4 border-t border-subtle">
        {talk.eventUrl && talk.eventUrl !== '#' && (
          <a href={talk.eventUrl} target="_blank" rel="noopener noreferrer" class="btn-primary flex-1 sm:flex-none justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Event Details
          </a>
        )}
      </div>
    </div>
  </div>
</dialog>

<script>
  // Setup modal logic using event delegation
  function setupTalkModals() {
    if ((window as any).talkModalsInitialized) return;
    (window as any).talkModalsInitialized = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      
      const openBtn = target.closest('[data-open-modal]') as HTMLElement;
      if (openBtn) {
        const modalId = openBtn.dataset.openModal;
        if (modalId && modalId.startsWith('talk-modal')) {
          const modal = document.getElementById(modalId) as HTMLDialogElement;
          if (modal) {
            modal.showModal();
            document.body.style.overflow = 'hidden';
            if ((window as any).lenis) (window as any).lenis.stop();
            return;
          }
        }
      }

      const closeBtn = target.closest('[data-close-modal]') as HTMLElement;
      if (closeBtn) {
        const modalId = closeBtn.dataset.closeModal;
        if (modalId && modalId.startsWith('talk-modal')) {
          const modal = document.getElementById(modalId) as HTMLDialogElement;
          if (modal) {
            modal.close();
            document.body.style.overflow = '';
            if ((window as any).lenis) (window as any).lenis.start();
            return;
          }
        }
      }

      if (target.tagName === 'DIALOG' && target.id.startsWith('talk-modal')) {
        const dialog = target as HTMLDialogElement;
        const rect = dialog.getBoundingClientRect();
        if (
          e.clientX < rect.left ||
          e.clientX > rect.right ||
          e.clientY < rect.top ||
          e.clientY > rect.bottom
        ) {
          dialog.close();
          document.body.style.overflow = '';
          if ((window as any).lenis) (window as any).lenis.start();
        }
      }
    });
  }

  setupTalkModals();
</script>

<style>
  dialog::backdrop {
    animation: fade-in 0.3s ease-out forwards;
  }
  dialog[open] {
    animation: scale-up 0.3s ease-out forwards;
  }
  
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes scale-up {
    from { opacity: 0; transform: scale(0.95) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(150,150,150,0.3);
    border-radius: 3px;
  }
</style>
