---
import type { Certification } from '../../content/certifications';

interface Props {
  certification: Certification;
  index: number;
}

const { certification, index } = Astro.props;
---

<a
  href={certification.credentialUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="glass-card rounded-2xl overflow-hidden group hover:-translate-y-1 hover:shadow-lg hover:shadow-accent-500/5 transition-all duration-500 block reveal-scale"
  style={`transition-delay: ${index * 100}ms;`}
  aria-label={`View ${certification.title} credential`}
>
  <!-- Image -->
  <div class="relative h-40 overflow-hidden bg-dark-800">
    <img
      src={certification.image}
      alt={certification.title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-950/30 to-transparent"></div>

    <!-- Year badge -->
    <div class="absolute top-3 right-3">
      <span class="badge text-[10px] bg-dark-950/60 backdrop-blur-sm border-white/10">{certification.year}</span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5">
    <h3
      class="text-sm font-semibold text-primary mb-1 group-hover:text-accent transition-colors duration-300 leading-snug"
      style="font-family: 'Outfit', sans-serif;"
    >
      {certification.title}
    </h3>
    <p class="text-xs text-muted">{certification.issuer}</p>

    <div class="mt-3 flex items-center gap-1.5 text-xs text-accent font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <span>View Credential</span>
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </div>
  </div>
</a>
