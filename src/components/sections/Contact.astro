---
import { personalInfo, socialLinks } from '../../content/social';
const linkedIn = socialLinks.find(link => link.id === 'linkedin');
---

<section id="contact" class="relative py-32 md:py-48 bg-section overflow-hidden border-t border-subtle">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-accent-500/10 via-section to-section"></div>
  
  <div class="relative z-10 max-w-5xl mx-auto px-6 md:px-12 text-center reveal-scale">
    <p class="text-accent-500 font-semibold tracking-widest uppercase text-sm mb-4">What's Next?</p>
    <h2 class="text-4xl md:text-5xl lg:text-7xl font-bold text-primary mb-6 tracking-tight" style="font-family: 'Outfit', sans-serif;">
      Let's build something <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-400 to-accent-600">amazing</span> together.
    </h2>
    <p class="text-secondary text-lg md:text-xl max-w-2xl mx-auto mb-12 leading-relaxed">
      Whether you have a specific project in mind, need help navigating your data, or just want to explore possibilities, I'm always open to discussing new opportunities.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 md:gap-8">
      <a href={`mailto:${personalInfo.email}`} class="text-xl md:text-2xl font-bold text-accent-400 hover:text-accent-300 transition-colors">
        {personalInfo.email}
      </a>
      
      <span class="hidden sm:block text-muted opacity-30 select-none">|</span>
      
      {linkedIn && (
        <a href={linkedIn.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:text-accent-400 transition-colors font-medium flex items-center gap-2 px-4 py-2">
          Connect on LinkedIn
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</section>
