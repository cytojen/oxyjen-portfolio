---
import SectionHeading from '../ui/SectionHeading.astro';
import { impactMetrics } from '../../content/impact';

const leadershipJourney = [
  {
    org: 'Amazon Web Services Cloud Club PUP',
    role: 'Data Science and Analytics Lead – Skill Builders Department',
    description: 'Led the design and delivery of hands on workshops on AWS data engineering, guiding participants through building serverless ETL pipelines with Amazon S3, AWS Lambda, Amazon Redshift, and Amazon Athena while developing technical learning materials and mentoring students throughout the sessions.',
    logo: '/images/organizations/awsccpup_logo.webp'
  },
  {
    org: 'DataCamp',
    role: 'Honorary Student Ambassador',
    description: 'Recognized as an Honorary DataCamp Classrooms Student Ambassador for expanding access to data and AI education, supporting the distribution of 1,100+ scholarship licenses and promoting active learning within the DataCamp community.',
    logo: '/images/organizations/dc_logo.png'
  },
  {
    org: 'Google Developer Groups Organization',
    role: 'Data and Machine Learning Co-Lead',
    description: 'Co-led the Data and Machine Learning team for a 300+ member community, organizing workshops, mentoring members, and driving technical initiatives in data analysis, data science, machine learning, and responsible AI.',
    logo: '/images/organizations/gdg_icon_logo.png'
  }
];
---

<section id="impact" class="relative py-24 md:py-32 bg-section-alt overflow-hidden">
  <div class="bg-glow bg-glow-purple w-[600px] h-[600px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-[0.06]"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 md:px-12">
    <SectionHeading
      label="Impact & Community"
      eyebrow="Making a Difference"
      description="Driving data literacy and access to education through community initiatives and open-source contributions."
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-0 relative items-center">
      
      <!-- Middle Line Separator for Desktop -->
      <div class="hidden lg:block absolute left-1/2 top-4 bottom-4 w-px bg-subtle -translate-x-1/2"></div>
      
      <!-- Column 1: Metrics -->
      <div class="w-full reveal-left flex flex-col justify-center space-y-5 lg:pr-16">
        {impactMetrics.map((metric, index) => (
          <div
            class="glass-card rounded-2xl p-6 group hover:translate-x-2 hover:shadow-lg hover:shadow-accent-500/5 transition-all duration-500 flex flex-row items-center gap-6"
            style={`transition-delay: ${index * 100}ms;`}
          >
            <!-- Icon -->
            <div class="w-14 h-14 rounded-xl bg-accent-500/10 border border-accent-500/20 flex items-center justify-center group-hover:bg-accent-500/20 transition-colors duration-300 shrink-0 shadow-inner">
              <svg class="w-6 h-6 text-accent-400 drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                {metric.icon === 'lucide:graduation-cap' && (
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
                )}
                {metric.icon === 'lucide:users' && (
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                )}
                {metric.icon === 'lucide:presentation' && (
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
                )}
              </svg>
            </div>

            <!-- Text Content -->
            <div class="flex flex-col text-left">
              <div class="flex items-baseline gap-1">
                <span
                  class="text-4xl font-bold text-primary counter drop-shadow-sm"
                  data-target={metric.value}
                  data-suffix={metric.suffix}
                  style="font-family: 'Outfit', sans-serif;"
                >
                  0{metric.suffix}
                </span>
              </div>
              <p class="text-xs md:text-sm text-muted font-medium uppercase tracking-wider mt-1">{metric.label}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Middle Line Separator for Mobile -->
      <div class="block lg:hidden w-full h-px bg-subtle"></div>

      <!-- Column 2: Community Roles -->
      <div class="w-full reveal-right lg:pl-16 flex flex-col justify-center space-y-6">
        {leadershipJourney.map((journey, index) => (
          <div
            class="group flex items-start gap-5 hover:translate-x-1 transition-all duration-400"
            style={`transition-delay: ${index * 100}ms;`}
          >
            <!-- Logo -->
            <img src={journey.logo} alt={journey.org} class="w-12 h-12 rounded-xl object-contain shrink-0 mt-0.5" />

            <!-- Text -->
            <div class="flex flex-col gap-1.5 min-w-0">
              <h4 class="text-base font-bold text-primary leading-tight group-hover:text-accent-400 transition-colors duration-300" style="font-family: 'Outfit', sans-serif;">
                {journey.org}
              </h4>
              <span class="text-[11px] font-semibold uppercase tracking-widest text-accent-500">
                {journey.role}
              </span>
              <p class="text-xs text-secondary leading-relaxed mt-1">
                {journey.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  // Setup intersection observer for counters
  const counters = document.querySelectorAll('.counter');

  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.target || '0', 10);
          const suffix = el.dataset.suffix || '';
          let current = 0;
          const increment = Math.ceil(target / 60);
          const duration = 2000;
          const stepTime = duration / (target / increment);

          const timer = setInterval(() => {
            current += increment;
            if (current >= target) {
               current = target;
               clearInterval(timer);
            }
            el.textContent = current.toLocaleString() + suffix;
          }, stepTime);

          counterObserver.unobserve(el);
        }
      });
    },
    { threshold: 0.5 }
  );

  counters.forEach((counter) => counterObserver.observe(counter));
</script>
