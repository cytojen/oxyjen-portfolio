---
import SectionHeading from '../ui/SectionHeading.astro';
import TalkCard from '../cards/TalkCard.astro';
import { talks } from '../../content/talks';

const featuredTalks = talks.filter((t) => t.featured).slice(0, 3);
const hasMore = talks.length > 3;
---

<section id="talks" class="relative py-24 md:py-32 bg-section overflow-hidden">
  <div class="bg-glow bg-glow-accent w-[400px] h-[400px] bottom-0 right-0"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 md:px-12">
    <SectionHeading
      label="Talks & Events"
      eyebrow="Speaking"
      description="Workshops and speaking engagements sharing knowledge with the community."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredTalks.map((talk, index) => (
        <TalkCard talk={talk} index={index} />
      ))}
    </div>

    {hasMore && (
      <div class="text-center mt-12">
        <a href="/talks" class="btn-secondary">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          View All Talks
        </a>
      </div>
    )}
  </div>
</section>
